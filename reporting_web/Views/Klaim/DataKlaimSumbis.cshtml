                                    function BuildPieChart(api) {

                                        var totalBPD = api.column(2).data().sum();
                                        var totalBSI = api.column(4).data().sum();
                                        var totalPeg = api.column(6).data().sum();
                                        var totalPNM = api.column(8).data().sum();
                                        var totalTravel = api.column(10).data().sum();
                                        var totalLain = api.column(12).data().sum();

                                        var ctx = document.getElementById("pieKlaimSumbis");
                                        if (pieChart != null)
                                            pieChart.destroy();
                                        pieChart = new Chart(ctx, {
                                            type: 'pie',
                                            data: {
                                                labels: [
                                                    "BPD",
                                                    "BSI",
                                                    "Pegadaian",
                                                    "PNM",
                                                    "Travel",
                                                    "Lain-lain"
                                                ],
                                                datasets: [{
                                                    data: [
