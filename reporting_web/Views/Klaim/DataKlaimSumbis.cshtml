                                                        totalPNM,
                                                        totalTravel,
                                                        totalLain
                                                    ],
                                                    backgroundColor: [
                                                        "#4CAF50",
                                                        "#2196F3",
                                                        "#FFC107",
                                                        "#F44336",
                                                        "#9C27B0",
                                                        "#607D8B"
                                                    ]
                                                }]
                                            },
                                            options: {
                                                responsive: true,
