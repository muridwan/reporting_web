@model reporting_web.Models.Datepickermodel
@{
    ViewBag.Title = "Data Klaim Loss Ratio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #tblklaimlossratio {
        width: 100% !important;
    }

    table.dataTable th,
    table.dataTable td {
        white-space: nowrap;
    }

    .dataTables_wrapper {
        width: 100%;
    }
</style>

<div id="loadingOverlay">
    <div class="loading-content">
        <div class="spinner"></div>
        <div class="loading-text">Loading data...</div>
    </div>
</div>

<link href="~/FrontEnd/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet" />
<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
<link href="~/Content/jquery.dataTables-1.11.2.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.bootstrap-1.11.2.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.fontAwesome-1.11.2.css" rel="stylesheet" />
<link href="~/Content/buttons.dataTables-2.0.1.min.css" rel="stylesheet" />
<link href="~/Content/rowReorder.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/responsive.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/colReorder.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/bootstrap-multiselect.css" rel="stylesheet" />
<link href="~/Content/loading.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.5.1.js"></script>
<script src="~/Scripts/AASReport/AasReport.js"></script>

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-header">
                <h2>Select Filter</h2>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div>
                                <label>Start Date</label>
                            </div>
                            <div>
                                <input id="fromdate" type="text" name="FromDate" class="datepicker" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div>
                                <label>End Date</label>
                            </div>
                            <div>
                                <input id="todate" type="text" name="ToDate" class="datepicker" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div>
                                <label>COB</label>
                            </div>
                            <div>
                                <input id="txtcobname" type="text" name="CobName" />
                                <input id="cobid" type="hidden" name="CobID" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div>
                                <label>TOC</label>
                            </div>
                            <div>
                                <select id="COBSel" multiple="multiple" required=required name="COBSel">
                                    @if (ViewBag.COBID != null)
                                    {
                                        foreach (var item in ViewBag.COBID)
                                        {
                                            if (item.Text != null)
                                            {
                                                <option value="@item.Value">
                                                    @item.Value-@item.Text
                                                </option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <div>
                                <label>Branch</label>
                            </div>
                            <div>
                                <select id="BranchSel" multiple="multiple" required=required name="BranchSel">

                                    @if (ViewBag.BranchCode != null)
                                    {
                                        foreach (var item in ViewBag.BranchCode)
                                        {
                                            if (item.Text != null)
                                            {
                                                <option value="@item.Value">
                                                    (@item.Value) @item.Text
                                                </option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-md-4">
                                    <button class="btn btn-info" id="btnKlaimLossRatio"> Load Data</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="divDynamic"></div>
                <div id="message_table"></div>
                <div id="message_table_cob"></div>
                <div id="message_table_toc"></div>
                <div id="message_table_branch"></div>
                <div id="divPeriode"></div>
                <div id="divGetPeriode"></div>

                <div>
                    <table id="tblklaimlossratio" class="display nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Branch</th>
                                <th>Branch Name</th>
                                <th>TOC</th>
                                <th>TOC Name</th>
                                <th>Segmen</th>

                                <th>Kontribusi Bruto</th>
                                <th>Komisi</th>
                                <th>Kontribusi Netto</th>
                                <th>Settled Claim</th>
                                <th>OS Claim</th>
                                <th>Total Claim</th>
                                <th>Subrogasi</th>
                                <th>Settled Claim - Net</th>

                                <th>LR Gross vs Settled Claim</th>
                                <th>LR Gross vs Total Claim</th>
                                <th>LR Gross vs Settled Claim Net</th>
                                <th>LR Net vs Settled</th>
                                <th>LR Net vs Total</th>
                                <th>LR Net vs Settled Claim Net</th>
                            </tr>
                        </thead>

                        <tfoot>
                            <tr>
                                <th></th> <!-- 0 No -->
                                <th>Total</th> <!-- 1 Branch -->
                                <th></th> <!-- 2 Branch Name -->
                                <th></th> <!-- 3 TOC -->
                                <th></th> <!-- 4 TOC Name -->
                                <th></th> <!-- 5 Segmen -->

                                <th id="totalPremi" align="right"></th>
                                <!-- 6 Kontribusi Bruto -->

                                <th id="totalPotongan" align="right"></th>
                                <!-- 7 Komisi -->

                                <th id="totalPremiNet" align="right"></th>
                                <!-- 8 Kontribusi Netto -->

                                <th id="totalSettleKlaim" align="right"></th>
                                <!-- 9 Settled Claim -->

                                <th id="totalOSKlaim" align="right"></th>
                                <!-- 10 OS Claim -->

                                <th id="totalClaim" align="right"></th>
                                <!-- 11 Total Claim -->

                                <th id="totalSubrogasi" align="right"></th>
                                <!-- 12 Subrogasi -->

                                <th id="totalKlaimNet" align="right"></th>
                                <!-- 13 Settled Claim - Net -->

                                <th id="totalLRSettleKlaim" align="right"></th>
                                <!-- 14 LR Gross vs Settled Claim -->

                                <th id="totalLRGrossTotal" align="right"></th>
                                <!-- 15 LR Gross vs Total Claim -->

                                <th id="totalLRGrossSettledNet" align="right"></th>
                                <!-- 16 LR Gross vs Settled Claim Net -->

                                <th id="totalLRNetSettled" align="right"></th>
                                <!-- 17 LR Net vs Settled -->

                                <th id="totalLRNetTotal" align="right"></th>
                                <!-- 18 LR Net vs Total -->

                                <th id="totalLRNetSettledNet" align="right"></th>
                                <!-- 19 LR Net vs Settled Claim Net -->
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="total"></div>
            </div>
        </div>
    </div>
</div>

