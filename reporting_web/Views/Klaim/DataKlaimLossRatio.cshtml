            $("#btnKlaimLossRatio").click(function () {

                // =========================================================
                // 1. AMBIL FILTER
                // =========================================================

                var $sdate = $('#fromdate').val();
                var $edate = $('#todate').val();

                var $cobid = $('#cobid').val();
                var $cobdes = $('#txtcobname').val();

                var $tocid = "%";
                var $listTOC = [];
                var $tocdes = "ALL";

                var $branchid = "%";
                var $listCab = [];
                var $kodecab = "''";                
                var $branchdes = "ALL";

                // =========================================================
                // 2. AMBIL TOC & BRANCH YANG DIPILIH
                // =========================================================

                var selected = $("#COBSel option:selected");

                //selected.each(function () {
                //    $tocid += " , TOC = " + $(this).val();
                //    $listTOC.push($(this).val());
                //    $tocdes += ",'" + $(this).text() + "'";
                //});

                if (selected.length > 0) { 

                    $listTOC = selected.map(function () {
                        return $(this).val().trim();
                    }).get();

                    $tocdes = selected.map(function() {
                        return $(this).text().trim()
                    }).get().join(", ");

                    $tocid = selected.map(function () { 
                        return $(this).val().trim();
                    }).get().join(", ")
                }
                

                //Branch Selected
                var selectedBranch = $('#BranchSel option:selected');

                if (selectedBranch.length > 0) {

                    $listCab = selectedBranch.map(function () {
                        return $(this).val().trim();
                    }).get();

                    $branchdes = selectedBranch.map(function () {
                        return $(this).text().trim();
                    }).get().join(", ");

                    $branchid = selectedBranch.map(function () {
                        return $(this).val().trim();
                    }).get().join(", ");                                        
                }


                // =========================================================
                // 3. DEFAULT COB
                // =========================================================

                if ($cobid == "" || $cobdes == "") {
                    $cobid = "%";
                    $cobdes = "ALL";
                }

                // =========================================================
                // 4. DEFAULT TOC & BRANCH
                // =========================================================

                //if ($tocid == "''" || $tocdes == "''") {
                //    $tocid = "%";
                //    $tocdes = "ALL";
                //}                
                //if ($branchid == "''" || $branchdes == "''") {
                //    $kodecab = "%";
                //    $branchdes = "ALL";
                //}
                // =========================================================
                // 5. VALIDASI TANGGAL
                // =========================================================

                if ($sdate == "" || $edate == "") {
                    alert("Start Date dan End Date harus diisi.");
                    return;
                }


                // =========================================================
                // 6. MESSAGE REPORT
                // =========================================================

                var $message = "PERIODE: " + $sdate + " s/d " + $edate + "\n";
                $message += "BY COB: " + $cobdes + "\n";
                $message += "BY TOC: " + $tocdes;
                $message += "BY Branch: " + $branchdes + "<br>";

                // Untuk EXCEL
                var $messageExcel =
                    "PERIODE: " + $sdate + " s/d " + $edate + "\n" +
                    "BY COB: " + $cobdes + "\n" +
                    "BY TOC: " + $tocdes + "\n" +
                    "BY Branch: " + $branchdes;

                // =========================================================
                // 7. TAMPILKAN FILTER DI HALAMAN
                // =========================================================

                $('#divPeriode').html('<b>Periode: ' + $sdate + ' s/d ' + $edate +'</b>');
                $('#message_table_cob').html('<b>BY COB: ' + $cobdes + '</b>');
                $('#message_table_toc').html('<b>BY TOC: ' + $tocdes + '</b>');
                $('#message_table_branch').html('<b>BY BRANCH: ' + $branchdes + '</b>');

                // =========================================================
                // 8. AMBIL INFORMASI PERIODE DATA KLAIM
                // =========================================================

                $.ajax({

                    url: '/master/getsysInfo/?stype=CLM',
                    dataType: "json",
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data && data.length > 0) {
                            $('#divGetPeriode').html('<b>Data Per: ' + data[0].datecomplete + '</b>');
                        }
                    },
                    error: function (xhr) {
                        console.log("getsysInfo error:",xhr.responseText);
                    }
                });


                // =========================================================
                // 9. HAPUS DATATABLE LAMA
                // =========================================================

                if ($.fn.DataTable.isDataTable('#tblklaimlossratio'))
                {
                    $('#tblklaimlossratio').DataTable().destroy();
                    $('#tblklaimlossratio tbody').empty();
                }

                // =========================================================
                // 10. TAMPILKAN LOADING
                // =========================================================

                DTLoading("#tblklaimlossratio");
                $('#loadingOverlay').addClass('show');

                // =========================================================
                // 11. DISABLE BUTTON
                // =========================================================

                var $btn = $('#btnKlaimLossRatio');
                $btn.prop('disabled',true);
                $btn.text('Generating Report...');

                // =========================================================
                // 12. GENERATE REPORT
                //
                // PENTING:
                // AJAX INI BUKAN DATATABLES
                //
                // Tujuannya hanya:
                //
                // Filter
                //    ↓
                // spLaporanLossRatio
                //    ↓
                // Cache
                //    ↓
                // ReportKey
                // =========================================================

                $.ajax({
                    url: '/Klaim/GenerateLossRatioReport',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        SDate:$sdate,
                        EDate:$edate,
                        COB:$cobid,
                        TOC:$tocid,
                        ListTOC: $listTOC.join(','),
                        BRANCH: $branchid,
                        ListBranch: $listCab.join(',')
                    },

                    success: function (response) {

                        // =================================================
                        // 13. CEK GENERATE
                        // =================================================

